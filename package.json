{
  "name": "chrome-country-flags",
  "version": "2.1.0",
  "description": "Replaces mysterious abbreviations automatically with the corresponding flag. The solution for Chromium users on Windows!",
  "scripts": {
    "build": "pnpm run build:webpack && pnpm run build:tailwind",
    "build:tailwind": "node scripts/build-css.cjs",
    "build:webpack": "webpack --config webpack.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node tests/storage.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:integration": "node tests/integration.cjs",
    "test:package": "node tests/package.cjs",
    "verify": "pnpm run build && pnpm run typecheck && pnpm test && pnpm run test:package && pnpm run test:browser && pnpm run test:integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthijs110/chromium-country-flags.git"
  },
  "author": "matthijs110",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matthijs110/chromium-country-flags/issues"
  },
  "homepage": "https://github.com/matthijs110/chromium-country-flags#readme",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "^0.3.4",
    "copy-webpack-plugin": "^14.0.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.10.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0",
      "onFail": "download"
    }
  }
}
